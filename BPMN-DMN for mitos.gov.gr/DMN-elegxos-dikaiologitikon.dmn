      <output id="OutputClause_1u1rbqu" label="ΕΛΕΓΧΟΣ ΥΠΑΙΤΙΟΤΗΤΑΣ" name="ypaitiothta" typeRef="boolean" />
      <rule id="DecisionRule_1ap49hw">
        <description>Υπάρχουν υπαίτιοι και έχει αποσταλλεί η δήλωση υπαιτίων, οπότε ο έλεγχος είναι έγκυρος ως πλήρης.</description>
        <inputEntry id="UnaryTests_1wbl8ix">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1wl72dr">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0vqlw2i">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0gn76kn">
        <description>Υπάρχουν υπαίτιοι και δεν έχει αποσταλλεί δήλωση υπαιτίων, οπότε ο έλεγχος είναι άκυρος ως μη πλήρης.</description>
        <inputEntry id="UnaryTests_0x0qpeo">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1rn1wfx">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_088qhlx">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0g0njqt">
        <description>Δεν υπάρχουν υπαίτιοι οπότε ο έλεγχος είναι έγκυρος και δεν απαιτείται δήλωση υπαιτίων.</description>
        <inputEntry id="UnaryTests_1plt24u">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0z2913b">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1na82hk">
          <text>true</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_1cymt7z" name="ΒΕΒΑΙΩΣΗ ΕΚΑΒ-ΤΟΤΑ" />
  <inputData id="InputData_1ibrlf4" name="ΔΗΛΩΣΗ ΥΠΑΙΤΙΩΝ" />
  <inputData id="InputData_0gsfu96" name="ΕΚΠΡΟΣΩΠΟΣ" />
  <decision id="Decision_00al9ce" name="ΕΛΕΓΧΟΣ ΕΚΠΡΟΣΩΠΗΣΗΣ">
    <informationRequirement id="InformationRequirement_031j9tb">
      <requiredInput href="#InputData_1oaqb7t" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0gw8bqv">
      <requiredInput href="#InputData_0gsfu96" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0mhq111">
      <input id="InputClause_07zo7my" label="ΥΠΑΡΞΗ ΕΚΠΡΟΣΩΠΗΣΗΣ" biodi:width="192">
        <inputExpression id="LiteralExpression_1t9dnzy" typeRef="boolean" />
      </input>
      <input id="InputClause_104j3oh" label="ΥΠΑΡΞΗ ΝΟΜΙΜΗΣ ΕΞΟΥΣΙΟΔΟΤΗΣΗΣ">
        <inputExpression id="LiteralExpression_11vf2h1" typeRef="boolean">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_1kcgypt" label="ΕΛΕΓΧΟΣ ΕΚΠΡΟΣΩΠΗΣΗΣ" name="ekprosophsh" typeRef="boolean" />
      <rule id="DecisionRule_0s5nl5c">
        <description>Υπάρχει εκπρόσωπος ο οποίος είναι νόμιμα εξουσιοδοτημένος, οπότε ο έλεγχος είναι έγκυρος.</description>
        <inputEntry id="UnaryTests_0v0vjmy">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0akla1l">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1vnj1c0">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_00539o3">
        <description>Υπάρχει εκπρόσωπος ο οποίος δεν είναι νόμιμα εξουσιοδοτημένος, οπότε ο έλεγχος είναι άκυρος.</description>
        <inputEntry id="UnaryTests_0ilf12f">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1phfvln">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1ytgbgu">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_11jgctc">
        <description>Δεν υπάρχει αίτημα για εκπροσώπηση, οπότε ο έλεγχος είναι έγκυρος χωρίς να απαιτείται εξουσιοδότηση κάποιου προσώπου.</description>
        <inputEntry id="UnaryTests_0g5oz62">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0cw6foa">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0marv4r">
          <text>true</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="InputData_13ghkk2" name="ΟΙΚΟΝΟΜΙΚΕΣ ΠΡΟΎΠΟΘΕΣΕΙΣ" />
  <inputData id="InputData_1jwc6r6" name="ΧΡΟΝΙΚΕΣ ΠΡΟΎΠΟΘΕΣΕΙΣ" />
  <inputData id="InputData_1p713nc" name="ΟΡΘΟΤΗΤΑ" />
  <decision id="Decision_0s15hic" name="ΕΛΕΓΧΟΣ ΕΓΚΥΡΟΤΗΤΑΣ ΠΡΟΫΠΟΘΕΣΕΩΝ">
    <informationRequirement id="InformationRequirement_1ww1me2">
      <requiredInput href="#InputData_1jwc6r6" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0ukeo62">
      <requiredInput href="#InputData_13ghkk2" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0zhs0yc">
      <input id="InputClause_177mxa4" label="ΧΡΟΝΙΚΕΣ ΠΡΟΫΠΟΘΕΣΕΙΣ (Δεν παρήλθε χρονικό διάστημα 8 μηνών από την ημερομηνία έκδοσης της ιατρικής γνωμάτευσης)" biodi:width="192">
        <inputExpression id="LiteralExpression_138sfi6" typeRef="boolean" />
      </input>
      <input id="InputClause_1r51rx9" label="ΟΙΚΟΝΟΜΙΚΕΣ ΠΡΟΫΠΟΘΕΣΕΙΣ (Ο ασφαλισμένος είναι ταμειακά ενήμερος την ημέρα του ατυχήματος)">
        <inputExpression id="LiteralExpression_1u2ki6l" typeRef="boolean">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_0hjbpfc" label="ΕΓΚΥΡΟΤΗΤΑ ΠΡΟΫΠΟΘΕΣΕΩΝ" name="proipotheseis" typeRef="boolean" />
      <rule id="DecisionRule_04on6cx">
        <description>Πληρούνται οι χρονικές και οικονομικές προϋποθέσεις.</description>
        <inputEntry id="UnaryTests_0uyes3p">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1x2h7fs">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1u4jeup">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1omoo1l">
        <description>Δεν πληρούνται οι χρονικές προϋποθέσεις, καθώς ο αιτών δεν υπέβαλε την αίτηση για λήψη παροχών σε χρήμα εντός 8 μηνών από την αναγγελία.</description>
        <inputEntry id="UnaryTests_0v1otcg">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0b2f5ah">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1jws6rp">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1h40v6s">
        <description>Δεν πληρούνται οι οικονομικές προϋποθέσεις, καθώς ο αιτών δεν ήταν ταμειακά ενήμερος την ημέρα του ατυχήματος.</description>
        <inputEntry id="UnaryTests_1c0m0ua">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0avtk7p">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_07ty2sg">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
